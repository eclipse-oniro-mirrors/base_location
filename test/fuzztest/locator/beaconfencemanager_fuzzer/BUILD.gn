import("//base/location/location/config.gni")
import("//build/config/features.gni")
import("//build/test.gni")

##############################fuzztest##########################################
ohos_fuzztest("BeaconFenceManagerFuzzTest") {
  module_out_path = "location/location"
  fuzz_config_file =
      "$LOCATION_ROOT_DIR/test/fuzztest/locator/beaconfencemanager_fuzzer"
  include_dirs = [
    "$LOCATION_ROOT_DIR/frameworks/js/napi/include",
    "$LOCATION_ROOT_DIR/interfaces/inner_api/include",
    "$LOCATION_ROOT_DIR/services/location_locator/locator/include",
  ]
  cflags = [
    "-g",
    "-O0",
    "-Wno-unused-variable",
    "-fno-omit-frame-pointer",
  ]
  sources = [ "beaconfencemanager_fuzzer.cpp" ]
  deps = [
    "$LOCATION_ROOT_DIR/frameworks/js/napi:geolocation_static",
    "$LOCATION_ROOT_DIR/frameworks/location_common/common:lbsservice_common_static",
    "$LOCATION_ROOT_DIR/services/location_locator/locator:lbsservice_locator_static",
  ]
  external_deps = [
    "ability_runtime:ability_connect_callback_stub",
    "access_token:libaccesstoken_sdk",
    "c_utils:utils",
    "common_event_service:cesfwk_innerkits",
    "eventhandler:libeventhandler",
    "ffrt:libffrt",
    "hilog:libhilog",
    "hisysevent:libhisysevent",
    "init:libbegetutil",
    "ipc:ipc_core",
    "libuv:uv",
    "napi:ace_napi",
    "samgr:samgr_proxy",
  ]

  defines = []

  if (communication_bluetooth_enable) {
    external_deps += [ "bluetooth:btframework" ]
    defines += [ "BLUETOOTH_ENABLE" ]
  }
}

###############################################################################
group("fuzztest") {
  testonly = true
  deps = []
}
